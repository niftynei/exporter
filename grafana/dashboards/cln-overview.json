        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\",node=\"$node\"}",
        "iconColor": "red",
        "name": "Firing CLN alerts",
        "step": "60s",
        "tagKeys": "alertname,severity",
        "textFormat": "{{alertname}}"
      }
    ]
  },
  "description": "Operational overview for the Rust Core Lightning Prometheus exporter.",
